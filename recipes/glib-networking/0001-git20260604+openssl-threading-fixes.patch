+
+#include "config.h"
+#include "gtlsutils.h"
+
+gboolean
+g_tls_issuer_would_create_cycle (GTlsCertificate *certificate,
+                                 GTlsCertificate *issuer)
+{
+  GTlsCertificate *c = issuer;
+
+  do
+  {
+    if (c == certificate)
+      return TRUE;
+    c = g_tls_certificate_get_issuer (c);
+  } while (c);
+
+  return FALSE;
+}
