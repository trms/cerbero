From 2d90309c5e87865f89c4d07424c875ab615e0bb6 Mon Sep 17 00:00:00 2001
From: Michael Catanzaro <mcatanzaro@gnome.org>
Date: Mon, 23 Feb 2026 16:55:00 -0600
Subject: [PATCH 12/50] tests: fix some resource leaks

This also adds two assertions to GTlsConnectionBase to clarify that the
errors are definitely not leaked at this point (they are not).

Part-of: <https://gitlab.gnome.org/GNOME/glib-networking/-/merge_requests/268>
---
 tls/base/gtlsconnection-base.c | 3 +++
 tls/tests/certificate.c        | 2 ++
 tls/tests/connection.c         | 5 +++++
 3 files changed, 10 insertions(+)

diff --git a/tls/base/gtlsconnection-base.c b/tls/base/gtlsconnection-base.c
index a3d8d2f..90f9450 100644
--- a/tls/base/gtlsconnection-base.c
+++ b/tls/base/gtlsconnection-base.c
@@ -2486,6 +2486,9 @@ g_tls_connection_base_close_internal (GIOStream      *stream,
   else
     {
       g_tls_log_debug (tls, "the TLS connection has been closed successfully");
+
+      g_assert (!close_error);
+      g_assert (!stream_error);
     }
 
   return success && status == G_TLS_CONNECTION_BASE_OK;
diff --git a/tls/tests/certificate.c b/tls/tests/certificate.c
index dd2412b..fe1059b 100644
--- a/tls/tests/certificate.c
+++ b/tls/tests/certificate.c
@@ -284,6 +284,8 @@ test_create_certificate_pkcs11 (TestCertificate *test,
 
   g_assert_no_error (error);
   g_assert_nonnull (cert);
+
+  g_object_unref (cert);
 #endif
 }
 
diff --git a/tls/tests/connection.c b/tls/tests/connection.c
index c4d42d7..e78c571 100644
--- a/tls/tests/connection.c
+++ b/tls/tests/connection.c
@@ -269,6 +269,7 @@ on_server_close_finish (GObject        *object,
   g_io_stream_close_finish (G_IO_STREAM (object), res, &error);
   // FIXME: https://gitlab.gnome.org/GNOME/glib-networking/issues/105
   // g_assert_no_error (error);
+  g_clear_error (&error);
 
   test->server_running = FALSE;
 }
@@ -506,6 +507,8 @@ on_client_connection_close_finish (GObject        *object,
    */
   if (!test->ignore_client_close_error)
     g_assert_no_error (error);
+  else
+    g_clear_error (&error);
 
   g_main_loop_quit (test->loop);
 }
@@ -1600,6 +1603,8 @@ test_client_auth_fail_missing_client_private_key (TestConnection *test,
 #else
   g_assert_error (test->server_error, G_TLS_ERROR, G_TLS_ERROR_NOT_TLS);
 #endif
+
+  g_object_unref (cert);
 }
 
 static void
