From 8c032f3d59d3c8f54d1992d53d595081e832e860 Mon Sep 17 00:00:00 2001
From: Ignacio Casal Quinteiro <qignacio@amazon.com>
Date: Mon, 1 Jun 2026 09:57:01 +0200
Subject: [PATCH 32/50] Fix oldest_expiration_time using INT_MAX instead of
 G_MAXINT64

The variable is gint64 but was initialized to INT_MAX, causing
incorrect cache cleanup after ~35 minutes of system uptime.

Part-of: <https://gitlab.gnome.org/GNOME/glib-networking/-/merge_requests/280>
---
 tls/base/gtlssessioncache.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tls/base/gtlssessioncache.c b/tls/base/gtlssessioncache.c
index 607f569..69d2cf0 100644
--- a/tls/base/gtlssessioncache.c
+++ b/tls/base/gtlssessioncache.c
@@ -63,7 +63,7 @@ session_cache_cleanup (GHashTable *cache)
   gpointer key, value;
   GTlsCacheData *cache_data;
   gchar *session_id = NULL;
-  gint64 oldest_expiration_time = INT_MAX;
+  gint64 oldest_expiration_time = G_MAXINT64;
   gboolean removed = FALSE;
 
   time = g_get_monotonic_time ();
-- 
2.54.0

From 10c77c7d4635ca538a542c5e76058ce86d8d4f5d Mon Sep 17 00:00:00 2001
From: Ignacio Casal Quinteiro <qignacio@amazon.com>
Date: Mon, 1 Jun 2026 10:27:46 +0200
Subject: [PATCH 33/50] Fix X509 leak in add_certs_from_store on Windows

d2i_X509 allocates a new X509 with refcount 1. X509_STORE_add_cert
takes its own internal reference but the caller's reference was never
freed, leaking one X509 object per certificate loaded from the Windows
system store.

Part-of: <https://gitlab.gnome.org/GNOME/glib-networking/-/merge_requests/280>
---
 tls/openssl/gtlsdatabase-openssl.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tls/openssl/gtlsdatabase-openssl.c b/tls/openssl/gtlsdatabase-openssl.c
index 11288cd..73a5cf5 100644
--- a/tls/openssl/gtlsdatabase-openssl.c
+++ b/tls/openssl/gtlsdatabase-openssl.c
@@ -341,7 +341,10 @@ add_certs_from_store (const gunichar2 *source_cert_store_name,
 
       x = d2i_X509 (NULL, &pdata, cert_context->cbCertEncoded);
       if (x)
-        X509_STORE_add_cert (store, x);
+        {
+          X509_STORE_add_cert (store, x);
+          X509_free (x);
+        }
     }
 
   CertCloseStore (store_handle, 0);
-- 
2.54.0

