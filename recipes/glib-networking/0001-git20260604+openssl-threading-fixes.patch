From b5905cb2c2a358e9a394dca1223febc4ce23bbdb Mon Sep 17 00:00:00 2001
From: Michael Catanzaro <mcatanzaro@gnome.org>
Date: Thu, 2 Apr 2026 14:50:37 -0500
Subject: [PATCH 37/50] openssl: fix error code confusion

I'm trying to debug a flaky test, but got stuck because of an unhelpful
error message:

Error reading data from TLS socket: error:00000005:lib(0)::reason(5)

First it's our own error prefix, followed by the result of
SSL_get_error() passed to ERR_error_string_n(). But ERR_error_string_n()
is supposed to receive the return value of ERR_get_error(), not
SSL_get_error(). Accordingly, it just spits back the provided invalid
integer code (5, corresponding to SSL_ERROR_SYSCALL) rather than giving
us a nice error message. Oops. Fix this by printing the result of
ERR_get_error() instead.

Additionally, ERR_get_error() frustratingly returns the *first* error in
the error queue, not the last error, so it's basically the opposite of
errno. And the documentation of SSL_get_error() says it only works if
the error queue is initially empty. Sigh. So, clear the queue before
performing I/O.

(I'm also not convinced our code is properly checking all possible
results from SSL_get_error(). But I won't attempt to fix this today.)
---
 tls/openssl/gtlsconnection-openssl.c | 16 ++++++++--------
 1 file changed, 8 insertions(+), 8 deletions(-)

diff --git a/tls/openssl/gtlsconnection-openssl.c b/tls/openssl/gtlsconnection-openssl.c
index 94bbad9..9f36785 100644
--- a/tls/openssl/gtlsconnection-openssl.c
+++ b/tls/openssl/gtlsconnection-openssl.c
@@ -93,8 +93,7 @@ end_openssl_io (GTlsConnectionOpenssl  *openssl,
                 int                     ret,
                 gboolean                blocking,
                 GError                **error,
-                const char             *err_prefix,
-                const char             *err_str)
+                const char             *err_prefix)
 {
   GTlsConnectionBase *tls = G_TLS_CONNECTION_BASE (openssl);
   GTlsConnectionOpensslPrivate *priv;
@@ -252,7 +251,7 @@ end_openssl_io (GTlsConnectionOpenssl  *openssl,
         *error = g_error_new (G_TLS_ERROR, G_TLS_ERROR_EOF, _("%s: The connection is broken"), gettext (err_prefix));
     }
   else if (error && !*error)
-    *error = g_error_new (G_TLS_ERROR, G_TLS_ERROR_MISC, "%s: %s", gettext (err_prefix), err_str);
+    *error = g_error_new (G_TLS_ERROR, G_TLS_ERROR_MISC, "%s: %s", gettext (err_prefix), ERR_reason_error_string (err));
 
 out:
   g_clear_error (&my_error);
@@ -289,7 +288,6 @@ perform_openssl_io (GTlsConnectionOpenssl  *openssl,
   while (TRUE)
     {
       GIOCondition io_needed;
-      char error_str[256];
       struct timeval tv;
       gint64 io_timeout;
 
@@ -298,6 +296,11 @@ perform_openssl_io (GTlsConnectionOpenssl  *openssl,
       if (g_tls_connection_base_is_dtls (tls))
         DTLSv1_handle_timeout (ssl);
 
+      /* Fragile: the perform_func must call no more than one OpenSSL function,
+       * or the OpenSSL error queue could be modified more than once before
+       * end_openssl_io(), breaking SSL_get_error().
+       */
+      ERR_clear_error ();
       ret = perform_func (ssl, perform_data);
 
       switch (SSL_get_error (ssl, ret))
@@ -313,10 +316,7 @@ perform_openssl_io (GTlsConnectionOpenssl  *openssl,
             break;
         }
 
-      ERR_error_string_n (SSL_get_error (ssl, ret), error_str,
-                          sizeof (error_str));
-      status = end_openssl_io (openssl, direction, ret, TRUE, error, err_prefix,
-                               error_str);
+      status = end_openssl_io (openssl, direction, ret, TRUE, error, err_prefix);
 
       if (status != G_TLS_CONNECTION_BASE_TRY_AGAIN)
         break;
