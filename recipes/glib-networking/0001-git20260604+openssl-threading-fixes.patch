From dcd303be7b200e3fb7868f0c6881ee3df230f8a1 Mon Sep 17 00:00:00 2001
From: Ignacio Casal Quinteiro <qignacio@amazon.com>
Date: Mon, 1 Jun 2026 09:51:56 +0200
Subject: [PATCH 29/50] Fix wrong assertion in
 g_tls_connection_base_write_message

The assertion was checking read_message_fn instead of write_message_fn.

Part-of: <https://gitlab.gnome.org/GNOME/glib-networking/-/merge_requests/280>
---
 tls/base/gtlsconnection-base.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tls/base/gtlsconnection-base.c b/tls/base/gtlsconnection-base.c
index 8453abe..2935fd7 100644
--- a/tls/base/gtlsconnection-base.c
+++ b/tls/base/gtlsconnection-base.c
@@ -2285,7 +2285,7 @@ g_tls_connection_base_write_message (GTlsConnectionBase  *tls,
                  timeout, cancellable, error))
     return -1;
 
-  g_assert (G_TLS_CONNECTION_BASE_GET_CLASS (tls)->read_message_fn);
+  g_assert (G_TLS_CONNECTION_BASE_GET_CLASS (tls)->write_message_fn);
   status = G_TLS_CONNECTION_BASE_GET_CLASS (tls)->
     write_message_fn (tls, vectors, num_vectors, timeout, &nwrote, cancellable, error);
 
-- 
2.54.0

From fa514b93b4f69f27ea0921a6474b39c8979fef13 Mon Sep 17 00:00:00 2001
From: Ignacio Casal Quinteiro <qignacio@amazon.com>
Date: Mon, 1 Jun 2026 09:53:26 +0200
Subject: [PATCH 30/50] Fix task name set on wrong task in handshake_async

g_task_set_name was called on caller_task instead of thread_task.

Part-of: <https://gitlab.gnome.org/GNOME/glib-networking/-/merge_requests/280>
---
 tls/base/gtlsconnection-base.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tls/base/gtlsconnection-base.c b/tls/base/gtlsconnection-base.c
index 2935fd7..d96e2ec 100644
--- a/tls/base/gtlsconnection-base.c
+++ b/tls/base/gtlsconnection-base.c
@@ -1920,7 +1920,7 @@ g_tls_connection_base_handshake_async (GTlsConnection      *conn,
 
   thread_task = g_task_new (conn, cancellable, async_handshake_thread_completed, caller_task);
   g_task_set_source_tag (thread_task, g_tls_connection_base_handshake_async);
-  g_task_set_name (caller_task, "[glib-networking] g_tls_connection_base_handshake_async (thread task)");
+  g_task_set_name (thread_task, "[glib-networking] g_tls_connection_base_handshake_async (thread task)");
   g_task_set_priority (thread_task, io_priority);
 
   timeout = g_new0 (gint64, 1);
-- 
2.54.0

From 9b2778c6197d7ca8d16f99abd3ef7ed179083f1b Mon Sep 17 00:00:00 2001
From: Ignacio Casal Quinteiro <qignacio@amazon.com>
Date: Mon, 1 Jun 2026 09:54:41 +0200
Subject: [PATCH 31/50] Fix potential NULL dereference on remote_addr in
 constructed

g_socket_connection_get_remote_address() can return NULL, use
g_clear_object to handle this safely.

Part-of: <https://gitlab.gnome.org/GNOME/glib-networking/-/merge_requests/280>
---
 tls/base/gtlsconnection-base.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tls/base/gtlsconnection-base.c b/tls/base/gtlsconnection-base.c
index d96e2ec..9028b5f 100644
--- a/tls/base/gtlsconnection-base.c
+++ b/tls/base/gtlsconnection-base.c
@@ -2876,7 +2876,7 @@ g_tls_connection_base_constructed (GObject *object)
                 }
               g_free (cert_hash);
             }
-          g_object_unref (remote_addr);
+          g_clear_object (&remote_addr);
         }
       g_object_unref (base_conn);
     }
