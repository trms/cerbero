From 425d27bac847a787384ff9d14d44c7031d623353 Mon Sep 17 00:00:00 2001
From: Michael Catanzaro <mcatanzaro@gnome.org>
Date: Thu, 4 Jun 2026 16:55:50 -0500
Subject: [PATCH 45/50] openssl: fail harder if setting certificate fails

If setting the GTlsServerConnectionOpenssl's certificate fails for some
reason, currently some of the error paths set the GError and fail the
operation, while other paths are soft fails that merely print a
g_warning(). I'm not sure why, because the TLS server is surely not
going to function correctly if there is something wrong with any of the
provided certificates. It's probably safer to return the error to the
caller and fail to create the GTlsServerConnection, rather than just
print it, which the application will not notice.
---
 tls/openssl/gtlsserverconnection-openssl.c | 12 ++++++++----
 1 file changed, 8 insertions(+), 4 deletions(-)

diff --git a/tls/openssl/gtlsserverconnection-openssl.c b/tls/openssl/gtlsserverconnection-openssl.c
index 75af69a..09b57f9 100644
--- a/tls/openssl/gtlsserverconnection-openssl.c
+++ b/tls/openssl/gtlsserverconnection-openssl.c
@@ -200,8 +200,10 @@ ssl_set_certificate (SSL              *ssl,
   if (SSL_clear_chain_certs (ssl) == 0)
     {
       ERR_error_string_n (ERR_get_error (), error_buffer, sizeof (error_buffer));
-      g_warning ("There was a problem clearing the chain certificates: %s",
-                 error_buffer);
+      g_set_error (error, G_TLS_ERROR, G_TLS_ERROR_BAD_CERTIFICATE,
+                   _("There was a problem clearing the chain certificates: %s"),
+                   error_buffer);
+      return FALSE;
     }
 
   /* Add all the issuers to create the full certificate chain */
@@ -219,8 +221,10 @@ ssl_set_certificate (SSL              *ssl,
       if (SSL_add1_chain_cert (ssl, issuer_x) == 0)
         {
           ERR_error_string_n (ERR_get_error (), error_buffer, sizeof (error_buffer));
-          g_warning ("There was a problem adding the chain certificate: %s",
-                     error_buffer);
+          g_set_error (error, G_TLS_ERROR, G_TLS_ERROR_BAD_CERTIFICATE,
+                       _("There was a problem adding the chain certificate: %s"),
+                       error_buffer);
+          return FALSE;
         }
     }
 
-- 
2.54.0

From e8018e4cd70bc4092a41a57a0cd2e8e2fb08df2f Mon Sep 17 00:00:00 2001
From: Michael Catanzaro <mcatanzaro@gnome.org>
Date: Thu, 4 Jun 2026 17:09:42 -0500
Subject: [PATCH 46/50] gnutls: always notify accepted-cas property after
 handshake

In a5edbfce8e87f915679032782dcee85369e23a53 I fixed an unrelated
threadsafety issue, and also decided to emit the notify for this
property less frequently, only when it's likely that there was a change
to accepted-cas, rather than always. But this change contains a bug so
it didn't work: the notify is actually still emitted always despite the
code trying to not do so anymore. And that is the only reason the change
did not break the testsuite, because the testsuite expects the notify to
happen, but in fact ***glib-networking does not itself send expected CAs
for client authentication***, meaning the property will never actually
be set when testing against GTlsServerConnection!

In 1d4ab5a4a31811ad536f3f27e4a495d4bcc991e6 I noticed that "there's
something wrong" when trying to enable the OpenSSL backend tests, and
reverted the change in the OpenSSL backend. But I didn't revert it for
the GnuTLS backend, because I assumed it was working fine (which it was,
because the change was broken).

In practice, this doesn't matter anymore because we have removed support
for rehandshaking and do not yet support post-handshake authentication,
so the property should always change exactly once. But the code is
clearly wrong and AI tools are noticing, as noticed in
glib-networking!280. We might as well fix it.

There are two possible future improvements here. (a) It would be better
to emit the notify only when there is an actual change. (b) It would be
highly desirable for GTlsServerConnection to notify the client what
accepted CAs are, to avoid breaking our testsuite in combination with
(a).
---
 tls/gnutls/gtlsclientconnection-gnutls.c | 9 +--------
 1 file changed, 1 insertion(+), 8 deletions(-)

diff --git a/tls/gnutls/gtlsclientconnection-gnutls.c b/tls/gnutls/gtlsclientconnection-gnutls.c
index 5f8e2eb..e05fe89 100644
--- a/tls/gnutls/gtlsclientconnection-gnutls.c
+++ b/tls/gnutls/gtlsclientconnection-gnutls.c
@@ -68,7 +68,6 @@ struct _GTlsClientConnectionGnutls
   gboolean session_data_override;
 
   GPtrArray *accepted_cas;
-  gboolean accepted_cas_changed;
 
   gnutls_pcert_st *pcert;
   unsigned int pcert_length;
@@ -331,7 +330,6 @@ g_tls_client_connection_gnutls_handshake_thread_retrieve_function (GTlsConnectio
   GTlsConnectionBase *tls = G_TLS_CONNECTION_BASE (conn);
   GTlsClientConnectionGnutls *gnutls = G_TLS_CLIENT_CONNECTION_GNUTLS (conn);
   GPtrArray *accepted_cas;
-  gboolean had_accepted_cas;
   GByteArray *dn;
   int i;
 
@@ -339,8 +337,6 @@ g_tls_client_connection_gnutls_handshake_thread_retrieve_function (GTlsConnectio
    * the algorithms given in pk_algos.
    */
 
-  had_accepted_cas = gnutls->accepted_cas != NULL;
-
   accepted_cas = g_ptr_array_new_with_free_func ((GDestroyNotify)g_byte_array_unref);
   for (i = 0; i < nreqs; i++)
     {
@@ -353,8 +349,6 @@ g_tls_client_connection_gnutls_handshake_thread_retrieve_function (GTlsConnectio
     g_ptr_array_unref (gnutls->accepted_cas);
   gnutls->accepted_cas = accepted_cas;
 
-  gnutls->accepted_cas_changed = gnutls->accepted_cas || had_accepted_cas;
-
   clear_gnutls_certificate_copy (&gnutls->pcert, &gnutls->pcert_length, &gnutls->pkey);
   g_tls_connection_gnutls_handshake_thread_get_certificate (conn, pcert, pcert_length, pkey);
 
@@ -455,8 +449,7 @@ g_tls_client_connection_gnutls_complete_handshake (GTlsConnectionBase   *tls,
   /* It may have changed during the handshake, but we have to wait until here
    * because we can't emit notifies on the handshake thread.
    */
-  if (gnutls->accepted_cas_changed)
-    g_object_notify (G_OBJECT (gnutls), "accepted-cas");
+  g_object_notify (G_OBJECT (gnutls), "accepted-cas");
 
   if (handshake_succeeded)
     {
-- 
